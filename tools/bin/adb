#!/bin/bash
# adb wrapper for agents: the phone is reachable over USB and over Wi-Fi, and the user may unplug
# the cable at any time. Picks Wi-Fi when it is reachable, otherwise USB, so callers can run
# plain `adb ...`. Put tools/bin first in PATH. Do not set ANDROID_SERIAL yourself.
REAL=/usr/bin/adb
USB=2fbe93cc
# Wi-Fi address lives in tools/bin/phone_wifi so it can change without touching this script.
WIFI=$(cat "$(dirname "$0")/phone_wifi" 2>/dev/null || echo 192.168.1.3:5555)
case "$1" in devices|connect|disconnect|start-server|version|pair) exec "$REAL" "$@";; esac
list=$("$REAL" devices 2>/dev/null)
echo "$list" | grep -qE "^$WIFI[[:space:]]+device" || { "$REAL" connect "$WIFI" >/dev/null 2>&1; list=$("$REAL" devices 2>/dev/null); }
if echo "$list" | grep -qE "^$WIFI[[:space:]]+device"; then
  export ANDROID_SERIAL=$WIFI
elif echo "$list" | grep -qE "^$USB[[:space:]]+device"; then
  export ANDROID_SERIAL=$USB
else
  export ANDROID_SERIAL=$WIFI
fi
exec "$REAL" "$@"
