diff --git a/buildscripts/scripts/shaderc.sh b/buildscripts/scripts/shaderc.sh
new file mode 100755
index 0000000..ad45d64
--- /dev/null
+++ b/buildscripts/scripts/shaderc.sh
@@ -0,0 +1,51 @@
+#!/bin/bash -e
+
+. ../../include/path.sh
+
+src_dir="$ANDROID_NDK_ROOT/sources/third_party/shaderc"
+
+case "$ndk_triple" in
+	aarch64-linux-android) abi=arm64-v8a ;;
+	arm-linux-androideabi) abi=armeabi-v7a ;;
+	i686-linux-android) abi=x86 ;;
+	x86_64-linux-android) abi=x86_64 ;;
+	*) echo "Unknown ndk_triple: $ndk_triple" >&2; exit 1 ;;
+esac
+
+if [ "$1" == "clean" ]; then
+	rm -rf "$src_dir"/obj "$src_dir"/libs
+	rm -rf "$prefix_dir/include/shaderc" "$prefix_dir/lib/libshaderc.a" "$prefix_dir/lib/pkgconfig/shaderc.pc"
+	exit 0
+elif [ "$1" != "build" ]; then
+	exit 255
+fi
+
+# Build shaderc using ndk-build
+"$ANDROID_NDK_ROOT/ndk-build" -C "$src_dir" \
+	NDK_PROJECT_PATH=. \
+	APP_BUILD_SCRIPT=Android.mk \
+	APP_STL=c++_static \
+	APP_ABI=$abi \
+	APP_PLATFORM=android-${apilvl:-24} \
+	APP_CFLAGS="-O2" \
+	APP_CXXFLAGS="-O2" \
+	libshaderc_combined \
+	-j$cores
+
+mkdir -p "$prefix_dir/include/shaderc" "$prefix_dir/lib/pkgconfig"
+cp -p "$src_dir/libshaderc/include/shaderc"/*.h "$prefix_dir/include/shaderc/"
+cp -p "$src_dir/libshaderc/include/shaderc"/*.hpp "$prefix_dir/include/shaderc/"
+cp -p "$src_dir/libs/c++_static/$abi/libshaderc.a" "$prefix_dir/lib/"
+
+cat > "$prefix_dir/lib/pkgconfig/shaderc.pc" <<EOF
+prefix=/usr/local
+exec_prefix=\${prefix}
+libdir=\${prefix}/lib
+includedir=\${prefix}/include
+
+Name: shaderc
+Description: Tools and libraries for Vulkan shader compilation
+Version: 2022.3
+Libs: -L\${libdir} -lshaderc -lc++
+Cflags: -I\${includedir}
+EOF
