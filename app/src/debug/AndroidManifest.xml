<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.vibeplayer.BenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vibeplayer.BENCHMARK" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.vibeplayer.DebugActionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.vibeplayer.DEBUG_ACTION" />
                <action android:name="com.vibeplayer.DEBUG_DOUBLE_TAP" />
                <action android:name="com.vibeplayer.REQUEST_PROFILING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
